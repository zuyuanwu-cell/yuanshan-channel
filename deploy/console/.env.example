# 只绑本机，由 Nginx 反代。不要改成 0.0.0.0。
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=4182
# 公网路径。心跳脚本写死 /console/api/presence，改这里就要同时改 public/presence.js 并重新构建静态站。
CONSOLE_BASE_PATH=/console

# openssl rand -hex 32
# 生产环境必填，至少 32 个字符。只放服务器上的这个文件，不要提交。
CONSOLE_SESSION_SECRET=

# SQLite 文件。目录不存在时会自动创建，权限 0600。备份这个文件即可带走账号。
CONSOLE_DATA_FILE=./data/console.sqlite

# auto：看到 https（X-Forwarded-Proto）才给 Cookie 加 Secure。
# 1 强制 Secure。0 仅用于本机 http。
CONSOLE_COOKIE_SECURE=auto

# 在线人数窗口，毫秒。限制在 120000–300000（2–5 分钟），超出会被夹到这个区间。默认 3 分钟。
CONSOLE_ONLINE_WINDOW_MS=180000

# 逗号分隔。表单和心跳接受这些 Origin，另外始终放行本机 Astro（127.0.0.1:4477 / localhost:4477）。
TRUSTED_ORIGINS=https://ys.tongzhoukuajing.com

# 留空则看板访问量是占位，在线人数仍可用。
# 推荐走容器本机端口。Nginx 会去掉 /umami 前缀，所以这里不要带 /umami。
UMAMI_API_URL=http://127.0.0.1:3001
UMAMI_WEBSITE_ID=
# Umami → Settings → API keys。优先用这个。
UMAMI_API_TOKEN=
# 没有 API key 时才用看板账号换短期 token。不要提交密码。
UMAMI_USERNAME=
UMAMI_PASSWORD=

# 两个都填时，启动会确保该邮箱是 admin（用户不存在就创建）。
# 先写好这两行并重启，再把 /console/ 告诉别人，这样第一个访客不会变成管理员。
CONSOLE_ADMIN_EMAIL=
CONSOLE_ADMIN_PASSWORD=
# 设为 1 时，启动会用上面的密码覆盖同邮箱用户，并升为 admin，同时作废该用户的旧会话。改完改回 0 再重启。
CONSOLE_ADMIN_RESET=0

NODE_ENV=production
