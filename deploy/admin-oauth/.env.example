OAUTH_CLIENT_ID=替换成GitHub_OAuth_App的Client_ID
OAUTH_CLIENT_SECRET=替换成GitHub_OAuth_App的Client_Secret
OAUTH_HOST=127.0.0.1
OAUTH_PORT=4181
TRUSTED_ORIGINS=https://ys.tongzhoukuajing.com
# 企业微信群机器人 Webhook。留空时合作表单和「生成订阅」都返回 503。
# 上一行为空时才读 YUANSHAN_WECOM_WEBHOOK_URL。只放在服务器 .env，不要提交真实 key。
# 不要写进 GitHub Actions。静态站构建不读取这一项。
WECOM_WEBHOOK_URL=
# YUANSHAN_WECOM_WEBHOOK_URL=
