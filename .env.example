# 构建时注入 Umami（留空 = 页面不加载统计脚本）
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# 在线心跳 public/presence.js 会打进静态站，向 /console/api/presence 发 POST。
# 控制台没启动时浏览器里这条请求失败，脚本会忽略，页面照常。不必为心跳加构建变量。

# 企业微信群机器人。静态构建不读取这一项。
# 真实值只放在宝塔 OAuth 桥的 deploy/admin-oauth/.env（该文件已被 gitignore）。
# 留空则 POST /oauth/api/contact 和 /oauth/api/subscribe 返回 503。
# 上一行为空时，桥才读 YUANSHAN_WECOM_WEBHOOK_URL。不要提交真实 key，也不要放进 GitHub Actions。
WECOM_WEBHOOK_URL=

# 本地/宝塔 build:baota 常用：
# BASE_PATH=/
# SITE_URL=https://ys.tongzhoukuajing.com
