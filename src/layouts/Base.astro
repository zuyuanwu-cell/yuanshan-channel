---
import { url } from '../lib/format';
import '@fontsource/noto-sans-sc/chinese-simplified-400.css';
import '@fontsource/noto-sans-sc/chinese-simplified-700.css';
import '@fontsource/noto-serif-sc/chinese-simplified-700.css';
import '../styles/global.css';
import ContactDock from '../components/ContactDock.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';
import TabBar from '../components/TabBar.astro';
import { getSite } from '../lib/content';
import { absoluteUrl, jsonLdScript, metaDescription, pageUrl, type Crumb } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  published?: string;
  modified?: string;
  citation?: string;
  crumbs?: Crumb[];
}

const site = getSite();
const {
  title,
  description = site.hero.lede,
  image = '/media/hero/rules.webp',
  ogType = 'website',
  noindex = false,
  published,
  modified,
  citation,
  crumbs = [],
} = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}｜美妆日化规则、合规与热销`;
const summary = metaDescription(description || site.hero.lede);
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin);
const imageUrl = absoluteUrl(image, origin);
const home = absoluteUrl('/', origin);
const orgId = `${home}#organization`;
const siteId = `${home}#website`;
const pageId = `${canonical.href}#webpage`;
const ogLocale = site.locale.replace('-', '_');
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: site.brand,
    alternateName: [site.channel, site.name],
    url: home,
    description: site.tagline,
    image: imageUrl,
  },
  {
    '@type': 'WebSite',
    '@id': siteId,
    name: site.name,
    url: home,
    inLanguage: site.locale,
    description: metaDescription(site.hero.lede, 140),
    publisher: { '@id': orgId },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${pageUrl('/hs-codes', origin)}?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'WebPage',
    '@id': pageId,
    url: canonical.href,
    name: fullTitle,
    description: summary,
    isPartOf: { '@id': siteId },
    inLanguage: site.locale,
    ...(published ? { datePublished: published } : {}),
    ...(modified ? { dateModified: modified } : {}),
  },
];
if (ogType === 'article' && title) {
  graph.push({
    '@type': 'Article',
    headline: title,
    description: summary,
    datePublished: published,
    dateModified: modified ?? published,
    inLanguage: site.locale,
    mainEntityOfPage: { '@id': pageId },
    author: { '@id': orgId },
    publisher: { '@id': orgId },
    image: imageUrl,
    ...(citation ? { isBasedOn: citation } : {}),
  });
}
if (crumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: pageUrl(crumb.href, origin),
    })),
  });
}
const structuredData = jsonLdScript({ '@context': 'https://schema.org', '@graph': graph });
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const umamiUrl = (import.meta.env.PUBLIC_UMAMI_URL || "").replace(/\/$/, "");
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || "";
const umamiEnabled = Boolean(umamiUrl && umamiId);
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <meta name="robots" content={robots} />
    <meta name="author" content={site.brand} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={site.locale} href={canonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`${site.name}，${site.focus}跨境资讯`} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`${site.name}，${site.focus}跨境资讯`} />
    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <script type="application/ld+json" set:html={structuredData} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {umamiEnabled && (
      <script
        defer
        src={`${umamiUrl}/script.js`}
        data-website-id={umamiId}
        data-host-url={umamiUrl}
        is:inline
      />
    )}
  </head>
  <body>
    <a class="skip" href="#content">{site.ui.skip}</a>
    <Header />
    <main id="content" class="wrap">
      <slot />
    </main>
    <Footer />
    <TabBar />
    <ContactDock />
    <Lightbox />
    <script>
      import '../scripts/ui.ts';
    </script>
    <!-- 在线心跳。失败会被脚本吞掉，不依赖控制台是否已经在这台机器上。 -->
    <script is:inline defer src={url('/presence.js')}></script>
  </body>
</html>
