---
import ServiceHint from '../../components/ServiceHint.astro';
import Base from '../../layouts/Base.astro';
import { getNewsBySlug, getSite } from '../../lib/content';
import { formatDate, url } from '../../lib/format';

const site = getSite();
const guidePath = '/guides/cross-border-cosmetics-regulations';

const markets = [
  { intent: '美国 FDA / MoCRA', label: '美国化妆品合规速查', href: '/compliance/us' },
  { intent: '欧盟 CPNP', label: '欧盟化妆品合规速查', href: '/compliance/eu' },
  { intent: '印尼 BPOM / 清真', label: '印尼 BPOM 与清真要点', href: '/compliance/id' },
  { intent: '泰国 FDA', label: '泰国美妆通报', href: '/compliance/th' },
  { intent: '马来 NPRA', label: '马来西亚 NPRA', href: '/compliance/my' },
  { intent: '新加坡 HSA', label: '新加坡 HSA', href: '/compliance/sg' },
  { intent: '越南 DAV', label: '越南产品公告', href: '/compliance/vn' },
  { intent: '澳洲 TGA', label: '澳大利亚合规', href: '/compliance/au' },
  { intent: '日本', label: '日本化妆品备案', href: '/compliance/jp' },
  { intent: '俄 / 欧亚', label: '俄罗斯 ТР ТС 009', href: '/compliance/ru' },
];

const newsPicks = [
  { slug: '2026-10-22-fda-mandatory-cosmetic-recall-guidance', label: 'FDA 化妆品强制召回终稿' },
  { slug: '2026-10-28-eaeu-tr-cu-009-decision-74-effective', label: '欧亚五国禁限用清单生效' },
  { slug: '2026-10-27-tga-sunscreen-reforms', label: '澳洲 TGA 防晒改革' },
  { slug: '2026-10-17-indonesia-halal-cosmetics-2028', label: '印尼美妆清真强制认证延期' },
  { slug: '2026-10-31-bpjph-387-halal-product-types-cosmetics', label: '印尼清真美妆产品清单（BPJPH 387）' },
  { slug: '2026-09-21-bpom-ingredient-rules-deadline', label: '印尼 BPOM 美妆成分新规' },
  { slug: '2026-06-12-thailand-24-prohibited-ingredients', label: '泰国美妆禁用成分' },
].map((item) => {
  const news = getNewsBySlug(item.slug);
  if (!news) throw new Error(`指南页缺少资讯 ${item.slug}`);
  return { ...item, date: news.date };
});

const faqs: { q: string; a: string; links: { href: string; label: string }[] }[] = [
  {
    q: '跨境美妆一定要在中国先备案吗？',
    a: '先看要卖到的目的国。中国化妆品注册备案页用来对照，不代替目标市场的备案、标签和本地责任人。把中国页和目标国页一起打开。',
    links: [{ href: '/compliance/cn', label: '中国化妆品注册备案' }],
  },
  {
    q: '美国是不是要 FDA 批文才能卖？',
    a: '美国化妆品一般不用事先审批。要做的是设施注册、产品列名和英文标签；注册和列名不等于 FDA 批准。细则见美国合规速查和站内 FDA 资讯。',
    links: [
      { href: '/compliance/us', label: '美国化妆品 FDA 合规' },
      { href: '/news/2026-10-22-fda-mandatory-cosmetic-recall-guidance', label: 'FDA 强制召回终稿' },
    ],
  },
  {
    q: '东南亚是不是一套东盟规则通用？',
    a: '东盟化妆品指令在标签上有共性，但印尼、泰国、马来西亚、新加坡、越南仍要各自通报，并且通常要本地公司或进口商出面。不能拿一国回执套另一个国家。',
    links: [
      { href: '/compliance/id', label: '印尼' },
      { href: '/compliance/th', label: '泰国' },
      { href: '/compliance/my', label: '马来西亚' },
      { href: '/compliance/sg', label: '新加坡' },
      { href: '/compliance/vn', label: '越南' },
    ],
  },
  {
    q: '清真认证是不是现在就必须有？',
    a: '不要把过期节点当成现行要求。印尼强制范围和顺延以 PP、BPJPH 为准。站内有延期说明和产品清单，打开原文后再排期。',
    links: [
      { href: '/news/2026-10-17-indonesia-halal-cosmetics-2028', label: '印尼清真延期说明' },
      { href: '/compliance/id', label: '印尼合规速查' },
    ],
  },
  {
    q: '欧亚「禁限用」影响哪些站？',
    a: '影响适用 ТР ТС 009 的欧亚成员市场。先看欧亚禁限用生效资讯，再打开俄罗斯和哈萨克斯坦合规页，其他成员页可以交叉对照。',
    links: [
      { href: '/news/2026-10-28-eaeu-tr-cu-009-decision-74-effective', label: '欧亚禁限用生效' },
      { href: '/compliance/ru', label: '俄罗斯' },
      { href: '/compliance/kz', label: '哈萨克斯坦' },
    ],
  },
  {
    q: '热销榜能当合规依据吗？',
    a: '不能。热销榜是公开名次的快照，写明抓取时间和覆盖范围，不说明商品已经备案或可以上架。选品可以看榜，上架要看平台规则和目的国合规。',
    links: [{ href: '/rankings', label: '热销榜' }],
  },
  {
    q: '你们代办入驻或注册吗？',
    a: '不代办。这是个人资讯站，不提供入驻代办，也不替代官方页面或法律意见。来源怎么核实、待核实是什么意思，见关于页。',
    links: [{ href: '/about', label: '关于页' }],
  },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="跨境美妆法规怎么查：目的国备案与平台规则入口"
  description="国内美妆日化要出海：先按国家看备案/标签/本地代表，再对照平台规则与热销；远山频道汇总入口与来源链接。"
  crumbs={[
    { name: '首页', href: '/' },
    { name: '法规指南', href: guidePath },
  ]}
  extraGraph={[faqLd]}
>
  <header class="page-head">
    <p class="kicker">美妆日化 · 出海前先查规则</p>
    <h1>跨境美妆法规怎么查</h1>
    <p class="lede">
      这一页帮你按顺序查：先选定要卖的市场，再打开该国合规速查，接着看最新资讯，最后对照平台规则和热销榜。它不是代办，也不是法律意见。
    </p>
  </header>

  <article class="prose">
    <p>
      每条资讯都附来源链接。标了「待核实」的条目来自媒体或第三方转述，引用前请打开原文。来源和「待核实」怎么用，见<a href={url('/about')}>关于页</a>。
    </p>

    <h2>先问清三件事</h2>
    <ol>
      <li>卖到哪个国家或地区。目的国监管决定备案、标签和本地责任人。</li>
      <li>走哪条销售渠道。Amazon、TikTok Shop、Shopee 和本地电商的上架要求不一样。</li>
      <li>你是品牌方、工厂还是出口商。责任人、进口商和通报持有人不是同一个角色。</li>
    </ol>
    <p>
      还没定市场，先看<a href={url('/compliance/compare')}>多国美妆合规对比</a>。渠道名称对不上时，打开<a href={url('/platforms')}>平台入驻与费用索引</a>。
    </p>

    <h2>按目的国查合规</h2>
    <p>点开国别页，看备案或注册、标签语言、本地代表和清关方面已经整理的公开要点。页面上的材料和费用以该页来源为准。</p>
  </article>

  <div class="reg-list">
    {
      markets.map((market) => (
        <a class="reg-row" href={url(market.href)}>
          <span class="pill pill-teal">{market.intent}</span>
          <strong>{market.label}</strong>
          <span class="muted">国别页</span>
        </a>
      ))
    }
    <a class="reg-row" href={url('/compliance')}>
      <span class="pill pill-regulation">全部</span>
      <strong>打开国家合规速查全部列表</strong>
      <span class="muted">更多国家</span>
    </a>
  </div>

  <article class="prose">
    <h3>东南亚美妆备案怎么入手</h3>
    <p>
      印尼、泰国、马来西亚、新加坡、越南和菲律宾不是一张回执走完全部市场。公开要求里常见的角色是本地公司或进口商。先分别看
      <a href={url('/compliance/id')}>印尼</a>、
      <a href={url('/compliance/th')}>泰国</a>、
      <a href={url('/compliance/my')}>马来西亚</a>、
      <a href={url('/compliance/sg')}>新加坡</a>、
      <a href={url('/compliance/vn')}>越南</a>、
      <a href={url('/compliance/ph')}>菲律宾</a>，
      再回到<a href={url('/compliance/compare')}>横向对比</a>看哪些事项各国都有。
    </p>

    <h2>最近法规动态</h2>
    <p>国别页是框架。禁限用、清真节点、防晒声称这类变化看资讯，并打开原文。</p>
  </article>

  <div class="reg-list">
    {
      newsPicks.map((item) => (
        <a class="reg-row" href={url(`/news/${item.slug}`)}>
          <time datetime={item.date}>{formatDate(item.date)}</time>
          <strong>{item.label}</strong>
          <span class="muted">资讯</span>
        </a>
      ))
    }
    <a class="reg-row" href={url('/news')}>
      <span class="pill">全部</span>
      <strong>全部资讯</strong>
      <span class="muted">按日期</span>
    </a>
  </div>

  <article class="prose">
    <h2>平台规则与热销</h2>
    <p>
      选品可以看榜，上架要同时看平台规则和目的国合规。平台入口和费用口径在<a href={url('/platforms')}>平台索引</a>。多站点公开热销在<a href={url('/rankings')}>美妆日化热销榜</a>，例如
      <a href={url('/rankings/amazon-us')}>Amazon 美国站</a>和
      <a href={url('/rankings/amazon-sg')}>Amazon 新加坡站</a>。
    </p>

    <h2>出口编码与税率</h2>
    <p>
      需要查美妆或家清税则时用<a href={url('/hs-codes')}>海关编码</a>。查不到的税率留空，页面不编造。
    </p>

    <h2>推荐查阅顺序</h2>
    <ol>
      <li>用<a href={url('/compliance/compare')}>横向对比</a>，或从本页选一个市场。</li>
      <li>打开对应的国家合规页，例如<a href={url('/compliance/us')}>美国</a>。</li>
      <li>读该页「最近变化」，再打开相关<a href={url('/news')}>资讯</a>。</li>
      <li>看<a href={url('/platforms')}>平台索引</a>和目标站<a href={url('/rankings')}>热销榜</a>。</li>
      <li>需要编码时用<a href={url('/hs-codes')}>海关编码</a>。</li>
      <li>仍不确定，回到国别页上的官方链接，或咨询合格顾问。本站不代办。</li>
    </ol>

    <h2>常见问题</h2>
    {
      faqs.map((item) => (
        <section>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
          <p>
            {item.links.map((link, index) => (
              <>
                {index > 0 && ' · '}
                <a href={url(link.href)}>{link.label}</a>
              </>
            ))}
          </p>
        </section>
      ))
    }

    <h2>下一步</h2>
    <p>先选国家，再决定要不要订阅这个市场的规则和榜单更新。</p>
    <div class="cc-head-links">
      <a class="text-link" href={url('/compliance')}>打开国家合规速查 →</a>
      <a class="text-link" href={url('/subscribe')}>关注市场 →</a>
    </div>
    <p>{site.footerNote}</p>
  </article>

  <ServiceHint
    layout="band"
    title="需要把这些要求落到项目上？"
    text="同舟跨境有自己的化妆品工厂，也做全球跨境美妆供应链。若你正在准备某个市场的上市，可以让我们帮忙把手续、材料和出口步骤对到具体品类上。"
    points={['梳理上市资料，对照目的国公开要求', '协助美妆日化编码归类', '衔接生产、出口和当地合规售卖']}
    note="页面信息仅供参考，不构成法律意见，也不代办平台入驻。"
    cta="和我们聊聊"
    prefill="我想了解美妆上市资料梳理和出口支持。"
  />
</Base>
