---
import DocName from '../../components/DocName.astro';
import DocPreviewDialog from '../../components/DocPreviewDialog.astro';
import Flag from '../../components/Flag.astro';
import NewsCard from '../../components/NewsCard.astro';
import ServiceHint from '../../components/ServiceHint.astro';
import Base from '../../layouts/Base.astro';
import { complianceTypeLabels, getCompliance, getComplianceCountry, newsForCountry } from '../../lib/content';
import { matchDoc } from '../../lib/doc-templates';
import { formatDate, url } from '../../lib/format';
import { REGULATION_DIGEST, countryGuide } from '../../lib/hubs';
import { compliancePageSeo } from '../../lib/seo';

export function getStaticPaths() {
  return getCompliance().map((c) => ({ params: { cc: c.country } }));
}
const c = getComplianceCountry(Astro.params.cc!)!;
const guide = countryGuide(c);
const news = newsForCountry(c.country);
const items = [...c.items].sort((a, b) => Number(b.mandatory) - Number(a.mandatory));
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const seo = compliancePageSeo(c);
const previewIds = new Set<string>();
let docCount = 0;
for (const item of items) {
  for (const doc of item.docs) {
    docCount += 1;
    const hit = matchDoc(doc, item.type);
    if (hit) previewIds.add(hit.id);
  }
}
---

<Base
  title={seo.title}
  titleBrand="channel"
  description={seo.description}
  crumbs={[
    { name: '首页', href: '/' },
    { name: '合规', href: '/compliance' },
    { name: c.name_zh, href: `/compliance/${c.country}` },
  ]}
>
  <header class="page-head">
    <p class="kicker"><a href={url('/compliance')}>← 国家合规速查</a></p>
    <h1><Flag cc={c.country} size="lg" class="cc-flag-lg" /> {c.name_zh}合规</h1>
    <p class="lede">{c.summary}</p>
    <p class="updated-line"><span class="live-dot" aria-hidden="true"></span>核实于 <time datetime={c.last_verified}>{formatDate(c.last_verified)}</time>
      {guide && <> · 更新于 <time datetime={guide.updated}>{formatDate(guide.updated)}</time></>}
      <span class="cc-diff" aria-label={`难度 ${c.difficulty}/3`}>{[1, 2, 3].map((n) => <i class={n <= c.difficulty ? 'on' : ''} />)}</span></p>
  </header>

  <div class="cc-with-help">
  <div class="cc-main">
  {guide && (
    <div class="cc-hub">
      <nav class="cc-hub-nav" aria-label="本页模块">
        <a href="#who">适用谁</a>
        <a href="#duties">义务表</a>
        <a href="#timeline">时间线</a>
        <a href="#sources">官方源</a>
      </nav>
      <p class="muted cc-hub-lead">下面四块只重排本页已有事项和链到本国的资讯，不新增义务。</p>

      <section id="who" aria-labelledby="who-title">
        <h2 id="who-title">适用谁</h2>
        <ul class="cc-who">
          {guide.who.map((row) => (
            <li>
              <strong>{row.role}</strong>
              <span>{row.matters.join('、')}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="duties" aria-labelledby="duties-title">
        <h2 id="duties-title">义务表（注册 · 列名 · 标签 · 责任人）</h2>
        <ul class="cc-duty-list">
          {guide.duties.map((row) => (
            <li>
              <span class="cc-duty-bucket">{row.bucket}</span>
              <div>
                <a href={`#${row.id}`}>{row.name}</a>
                {row.needs_review && <span class="stamp stamp-review">待核实</span>}
                <p class="muted">{row.who}</p>
              </div>
              <p class="cc-duty-point">{row.point}</p>
            </li>
          ))}
        </ul>
        <p class="muted cc-hub-lead">清真、禁限用、包装、税号等没有归进这四类的事项，仍在下方事项明细。</p>
      </section>

      <section id="timeline" aria-labelledby="timeline-title">
        <h2 id="timeline-title">时间线</h2>
        <p class="muted cc-hub-lead">近 12 个月，以及站内已经写明的更晚日期。新的在前。</p>
        {guide.timeline.length === 0 ? (
          <p class="muted">这一档还没有写上日期的资讯。</p>
        ) : (
          <ol class="cc-timeline">
            {guide.timeline.map((event) => (
              <li>
                <time datetime={event.date}>{formatDate(event.date)}</time>
                <a href={url(event.href)}>{event.title}</a>
                <span class="muted">{event.label}{event.needs_review ? ' · 待核实' : ''}</span>
              </li>
            ))}
          </ol>
        )}
      </section>

      <section id="sources" aria-labelledby="sources-title">
        <h2 id="sources-title">官方源</h2>
        <ul class="cc-sources">
          {guide.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">官方来源 · {host(source.url)} ↗</a>
              <span class="muted">{source.authority} · {source.matters.join('、')}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  )}

  <ol class="cc-steps scroll-x" aria-label="办理顺序">
    {c.steps.map((s, i) => <li><span class="cc-step-no">{i + 1}</span><span>{s.title}</span></li>)}
  </ol>

  {docCount > 0 && (
    <p class="cc-doc-legend">材料名称可以打开样式，看这类文件大概长什么样。<a href={url('/compliance/templates')}>全部样式</a></p>
  )}

  {guide && <h2 class="section-title" id="items">事项明细</h2>}
  <div class="cc-items">
    {items.map((it) => (
      <article class={`cc-item card ${it.mandatory ? 'is-must' : ''}`} id={it.id}>
        <div class="card-top">
          <span class={`pill ${it.mandatory ? 'pill-must' : 'pill-opt'}`}>{it.mandatory ? '必须' : '建议'}</span>
          <span class="pill pill-teal">{complianceTypeLabels[it.type]}</span>
          {it.needs_review && <span class="stamp stamp-review">待核实</span>}
        </div>
        <h2 class="cc-item-title">{it.name_zh}</h2>
        <p class="cc-auth">🏛 {it.authority}{it.who && <span class="muted"> · 👤 {it.who}</span>}</p>
        <p class="cc-facts"><span>💰 {it.cost}</span><span>⏱ {it.time}</span></p>
        {it.type === 'tax-customs' && c.hs_codes.status === 'pending' && <p class="cc-hs muted">HS 编码整理中</p>}
        {it.type === 'tax-customs' && c.hs_codes.items.length > 0 && (
          <>
            <ul class="cc-hs-list">{c.hs_codes.items.map((h) => <li><code>{h.code}</code> {h.name_zh}{h.duty && <span class="muted"> · {h.duty}</span>}</li>)}</ul>
            <a class="text-link cc-hs-more" href={url(`/hs-codes?country=${c.country}`)}>查看全部编码 →</a>
          </>
        )}
        {it.type === 'tax-customs' && c.hs_codes.items.length === 0 && (
          <a class="text-link cc-hs-more" href={url(`/hs-codes?country=${c.country}`)}>去海关编码页查看 →</a>
        )}
        {it.note && <p class="cc-note">{it.note}</p>}
        {it.docs.length > 0 && (
          <details class="cc-docs">
            <summary>
              材料 {it.docs.length}
              {it.docs.some((doc) => matchDoc(doc, it.type)) && <span class="cc-doc-can"> · 可看样式</span>}
            </summary>
            <ul class="cc-doc-list">
              {it.docs.map((doc) => <DocName name={doc} type={it.type} />)}
            </ul>
          </details>
        )}
        <a class="text-link cc-src" href={it.official_url} target="_blank" rel="noopener noreferrer">官方来源 · {host(it.official_url)} ↗</a>
      </article>
    ))}
  </div>

  {news.length > 0 && (
    <section class="cc-news">
      <h2 class="section-title">最近变化</h2>
      <div class="news-grid">{news.map((n) => <NewsCard item={n} />)}</div>
    </section>
  )}
  <p class="cc-digest-link"><a class="text-link" href={url(REGULATION_DIGEST.path)}>{REGULATION_DIGEST.title} →</a></p>
  <p class="muted cc-disclaimer">仅供参考，以官方最新规定为准。</p>
  </div>
  <ServiceHint
    title={`准备进入${c.name_zh}？`}
    text="这页整理的是公开要求。若要对照你的品类梳理材料、安排出口，或衔接当地合规售卖，可以和同舟跨境聊聊。"
    points={['按品类梳理材料和手续', '出口准备与供应链衔接', '当地合规售卖上的实操问题']}
    note="不代办平台入驻，也不替代该市场的官方文本或法律意见。"
    cta="聊聊这个市场"
    prefill={`我想咨询${c.name_zh}的上市资料和出口。`}
  />
  </div>
  <DocPreviewDialog ids={[...previewIds]} market={c.name_zh} />
</Base>
