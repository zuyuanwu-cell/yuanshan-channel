---
import { getSite } from '../lib/content';
import { url } from '../lib/format';

const site = getSite();
const contact = site.contact;
const qr = url(contact.wechatQr);
---

<div class="contact-dock">
  <div class="contact-wechat" data-wechat>
    <div id="wechat-popover" class="contact-qr" data-wechat-panel role="region" aria-label={contact.wechatQrNote} hidden>
      <div class="contact-qr-card">
        <img
          src={qr}
          alt=""
          width="607"
          height="607"
          decoding="async"
          fetchpriority="low"
        />
        <p>{contact.wechatQrNote}</p>
      </div>
    </div>
    <button
      type="button"
      class="contact-wechat-btn"
      data-wechat-btn
      aria-label="添加微信"
      aria-expanded="false"
      aria-controls="wechat-popover"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M9.1 3.8C5.7 3.8 3 6.1 3 9c0 1.6.9 3.1 2.2 4L4.8 15.6l2.4-1.3c.6.2 1.2.3 1.9.3.3 0 .5 0 .8-.1-.2-.5-.4-1.1-.4-1.7 0-3 2.9-5.4 6.4-5.4.3 0 .6 0 .9.1C15.8 5.2 12.7 3.8 9.1 3.8Zm-2.1 4a.85.85 0 1 1 0 1.7.85.85 0 0 1 0-1.7Zm4 0a.85.85 0 1 1 0 1.7.85.85 0 0 1 0-1.7Z" />
        <path fill="currentColor" d="M16.8 9.4c-2.9 0-5.2 2-5.2 4.4s2.3 4.4 5.2 4.4c.5 0 1-.1 1.5-.2l2 1-.5-1.7c1.1-.8 1.8-1.9 1.8-3.1 0-2.4-2.3-4.4-5.2-4.4Zm-1.7 3.5a.7.7 0 1 1 0 1.4.7.7 0 0 1 0-1.4Zm3.3 0a.7.7 0 1 1 0 1.4.7.7 0 0 1 0-1.4Z" />
      </svg>
    </button>
  </div>
  <button
    type="button"
    class="contact-cta"
    data-contact-open
    aria-haspopup="dialog"
    aria-controls="contact-sheet"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 7.5h14a1 1 0 0 1 1 1v6.2a1 1 0 0 1-1 1H9.2L5 19.2z" />
    </svg>
    {contact.collabLabel}
  </button>
</div>

<dialog
  id="contact-sheet"
  class="contact-sheet"
  data-contact-dialog
  aria-labelledby="contact-sheet-title"
>
  <button type="button" class="contact-sheet-close" data-contact-close aria-label={contact.closeLabel}>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>
  <h2 id="contact-sheet-title">{contact.sheetTitle}</h2>
  <form
    class="contact-form"
    data-contact-form
    data-webhook={contact.webhookPath}
    data-submit={contact.submitLabel}
    data-sending={contact.sendingLabel}
    data-error={contact.errorNote}
    data-unconfigured={contact.unconfiguredNote}
    data-rate={contact.rateLimitNote}
    novalidate
  >
    <p class="contact-sheet-note">{contact.wechatQrNote}</p>
    <label class="contact-field">
      <span>{contact.nameLabel}</span>
      <input name="name" type="text" required maxlength="40" autocomplete="name" />
    </label>
    <label class="contact-field">
      <span>{contact.contactLabel}</span>
      <input
        name="contact"
        type="text"
        required
        maxlength="80"
        autocomplete="on"
        placeholder={contact.contactPlaceholder}
      />
    </label>
    <label class="contact-field">
      <span>{contact.messageLabel}</span>
      <textarea name="message" required maxlength="500" rows="4"></textarea>
    </label>
    <div class="contact-hp" aria-hidden="true">
      <label>
        请留空
        <input name="ys_leave_blank" type="text" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <p class="contact-status" data-contact-status role="alert" hidden></p>
    <div class="contact-actions">
      <button type="button" class="contact-cancel" data-contact-close>{contact.cancelLabel}</button>
      <button type="submit" class="contact-submit">{contact.submitLabel}</button>
    </div>
  </form>
  <div class="contact-success" data-contact-success hidden tabindex="-1">
    <p>{contact.successNote}</p>
    <button type="button" class="contact-submit" data-contact-close>{contact.closeLabel}</button>
  </div>
</dialog>
