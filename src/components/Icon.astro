---
import type { NavIcon } from '../lib/types';

interface Props {
  name: NavIcon | 'arrow';
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'home' && <path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z" />}
  {name === 'news' && (
    <>
      <rect x="4" y="4.5" width="16" height="15" rx="3" />
      <path d="M8 9h8M8 12.5h8M8 16h5" />
    </>
  )}
  {name === 'rankings' && <path d="M5 20v-6M12 20V6M19 20v-9M3 20h18" />}
  {name === 'platforms' && (
    <>
      <circle cx="12" cy="12" r="8" />
      <path d="M4 12h16M12 4c2.5 2.6 2.5 13.4 0 16M12 4c-2.5 2.6-2.5 13.4 0 16" />
    </>
  )}
  {name === 'about' && <path d="m3 19 6.5-11 4 6 2.5-3.5L21 19z" />}
  {name === 'compliance' && <path d="M12 3.5 19 6v5.5c0 4.3-2.9 7.7-7 9-4.1-1.3-7-4.7-7-9V6zM8.8 12.2l2.2 2.2 4.3-4.6" />}
  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8" />}
</svg>
