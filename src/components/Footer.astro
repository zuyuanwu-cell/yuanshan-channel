---
import { getSite, latestContentDate } from '../lib/content';
import { formatDate, url } from '../lib/format';

const site = getSite();
---

<footer class="site-footer">
  <div class="wrap inner">
    <strong>{site.name}</strong>
    <p>
      {site.ui.updatedAt} <time datetime={latestContentDate()}>{formatDate(latestContentDate())}</time>
    </p>
    <p>{site.disclaimer}</p>
    <p>{site.footerNote}</p>
    <p class="admin-entry">
      <a href={url("/admin/")}>编辑入口</a>
    </p>
  </div>
</footer>
