---
import BrandMark from './BrandMark.astro';
import { getSite, latestContentDate } from '../lib/content';
import { formatDate, isActivePath, url } from '../lib/format';
import SocialIcon from './SocialIcon.astro';

const site = getSite();
const path = Astro.url.pathname;
const quietNotes = site.social.filter((item) => !item.href.startsWith('https://') && item.hint);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="brand" href={url('/')} aria-label={site.name}>
          <BrandMark />
          <span class="brand-text">
            <strong>{site.channel}</strong>
            <em>{site.brand}</em>
          </span>
        </a>
        <p class="footer-tagline">{site.tagline}</p>
      </div>
      <nav class="footer-nav" aria-label="页脚导航">
        <p class="footer-kicker">栏目</p>
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isActivePath(path, item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="footer-social">
        <p class="footer-kicker">关注</p>
        <ul class="social-row">
          {
            site.social.map((item) => {
              const linked = item.href.startsWith('https://');
              const known = linked || Boolean(item.hint);
              const caption = item.hint ? `${item.label}，${item.hint}` : item.label;
              return (
                <li>
                  {linked ? (
                    <a
                      class="social-link"
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${caption}，新窗口`}
                      title={item.hint}
                    >
                      <SocialIcon id={item.id} />
                      <span>{item.label}</span>
                    </a>
                  ) : (
                    <span
                      class:list={['social-link', known ? 'is-known' : 'is-off']}
                      aria-disabled={known ? undefined : 'true'}
                      aria-label={known ? caption : `${item.label}，链接待补充`}
                      title={item.hint}
                    >
                      <SocialIcon id={item.id} />
                      <span>{item.label}</span>
                    </span>
                  )}
                </li>
              );
            })
          }
        </ul>
        {
          quietNotes.length > 0 && (
            <ul class="social-notes">
              {quietNotes.map((item) => (
                <li>
                  {item.label}：{item.hint}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    <div class="footer-base">
      <div class="footer-quiet">
        <p>
          {site.ui.updatedAt} <time datetime={latestContentDate()}>{formatDate(latestContentDate())}</time>
        </p>
        <p>{site.disclaimer}</p>
        <p>{site.footerNote}</p>
        <p class="footer-beian">
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2026083231号-1</a>
        </p>
        <p class="admin-entry" data-staff-links data-staff-sep hidden></p>
      </div>
      <aside class="footer-wechat" aria-label="添加微信">
        <p class="footer-kicker">微信</p>
        <div class="footer-qr-card">
          <img
            src={url(site.contact.wechatQr)}
            alt={`微信二维码，${site.contact.wechatQrNote}`}
            width="607"
            height="607"
            decoding="async"
            loading="lazy"
          />
          <p aria-hidden="true">{site.contact.wechatQrNote}</p>
        </div>
      </aside>
    </div>
  </div>
</footer>
