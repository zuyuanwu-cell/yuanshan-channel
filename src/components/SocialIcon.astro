---
import type { SocialId } from '../lib/types';

interface Props {
  id: SocialId;
}

const { id } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {id === 'douyin' && (
    <>
      <path d="M9 18V6.5l9-2V16" />
      <circle cx="6.5" cy="18" r="2.5" />
      <circle cx="15.5" cy="16" r="2.5" />
    </>
  )}
  {id === 'channels' && (
    <>
      <rect x="3.5" y="5" width="17" height="14" rx="4" />
      <path d="M10 9.2 15.2 12 10 14.8z" />
    </>
  )}
  {id === 'xiaohongshu' && (
    <>
      <path d="M5 5.5h5.2A2.3 2.3 0 0 1 12.5 7.8V19H7.2A2.2 2.2 0 0 1 5 16.8z" />
      <path d="M19 5.5h-5.2A2.3 2.3 0 0 0 11.5 7.8V19h5.3A2.2 2.2 0 0 0 19 16.8z" />
    </>
  )}
  {id === 'weibo' && (
    <>
      <circle cx="12" cy="12" r="8" />
      <circle cx="12" cy="12" r="2.4" />
      <path d="M8.2 15.2c1 .9 2.3 1.4 3.8 1.4s2.8-.5 3.8-1.4" />
    </>
  )}
</svg>
