{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SiteConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "brand",
    "channel",
    "tagline",
    "focus",
    "locale",
    "updated",
    "disclaimer",
    "footerNote",
    "social",
    "contact",
    "featuredPlatformIds",
    "featuredNote",
    "nav",
    "headerCta",
    "hero",
    "categoryLabels",
    "regions",
    "stamps",
    "reviewBanner",
    "rankingBanner",
    "sections",
    "pages",
    "empty",
    "notFound",
    "ui",
    "newsTags",
    "rankingGaps",
    "rankingPlatforms"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 4
    },
    "focus": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 8
    },
    "footerNote": {
      "type": "string",
      "minLength": 4
    },
    "social": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "href"],
        "properties": {
          "id": {
            "enum": ["douyin", "channels", "xiaohongshu", "weibo"]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "href": {
            "type": "string",
            "pattern": "^$|^https://\\S+$"
          },
          "hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wechatQr",
        "wechatQrNote",
        "collabLabel",
        "webhookPath",
        "sheetTitle",
        "nameLabel",
        "contactLabel",
        "contactPlaceholder",
        "messageLabel",
        "submitLabel",
        "sendingLabel",
        "cancelLabel",
        "closeLabel",
        "successNote",
        "errorNote",
        "unconfiguredNote",
        "rateLimitNote"
      ],
      "properties": {
        "wechatQr": {
          "type": "string",
          "pattern": "^/media/[A-Za-z0-9/_.-]+\\.(webp|png|jpe?g)$"
        },
        "wechatQrNote": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "collabLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8
        },
        "webhookPath": {
          "type": "string",
          "pattern": "^/oauth/[A-Za-z0-9/_-]+$"
        },
        "sheetTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 12
        },
        "nameLabel": { "type": "string", "minLength": 1, "maxLength": 8 },
        "contactLabel": { "type": "string", "minLength": 1, "maxLength": 8 },
        "contactPlaceholder": { "type": "string", "minLength": 1, "maxLength": 24 },
        "messageLabel": { "type": "string", "minLength": 1, "maxLength": 8 },
        "submitLabel": { "type": "string", "minLength": 1, "maxLength": 8 },
        "sendingLabel": { "type": "string", "minLength": 1, "maxLength": 8 },
        "cancelLabel": { "type": "string", "minLength": 1, "maxLength": 8 },
        "closeLabel": { "type": "string", "minLength": 1, "maxLength": 8 },
        "successNote": { "type": "string", "minLength": 2, "maxLength": 40 },
        "errorNote": { "type": "string", "minLength": 2, "maxLength": 40 },
        "unconfiguredNote": { "type": "string", "minLength": 2, "maxLength": 40 },
        "rateLimitNote": { "type": "string", "minLength": 2, "maxLength": 40 }
      }
    },
    "featuredPlatformIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "featuredNote": {
      "type": "string",
      "minLength": 4
    },
    "nav": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "href",
          "label",
          "icon"
        ],
        "properties": {
          "href": {
            "type": "string",
            "pattern": "^/([a-z0-9-]+)?$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "icon": {
            "enum": [
              "home",
              "news",
              "rankings",
              "compliance",
              "codes",
              "platforms",
              "about"
            ]
          }
        }
      }
    },
    "headerCta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "href": {
          "$ref": "#/definitions/internalHref"
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge",
        "badgeNote",
        "titleLine1",
        "titleLine2",
        "lede",
        "cardCta",
        "swipeHint",
        "tags",
        "cards"
      ],
      "properties": {
        "badge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "badgeNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "titleLine1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "titleLine2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "lede": {
          "type": "string",
          "minLength": 8,
          "maxLength": 90
        },
        "cardCta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "swipeHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "tags": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "tone",
              "side"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 14
              },
              "tone": {
                "enum": [
                  "teal",
                  "coral",
                  "violet",
                  "lime"
                ]
              },
              "side": {
                "enum": [
                  "left",
                  "right"
                ]
              }
            }
          }
        },
        "cards": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "subtitle",
              "href",
              "image",
              "colorTop",
              "colorBottom"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8
              },
              "subtitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "href": {
                "$ref": "#/definitions/internalHref"
              },
              "image": {
                "type": "string",
                "pattern": "^/media/[A-Za-z0-9/_.-]+\\.(webp|png|jpe?g|svg|avif)$"
              },
              "colorTop": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "colorBottom": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "statKey": {
                "enum": [
                  "news",
                  "rules",
                  "regulation",
                  "rankings",
                  "platforms"
                ]
              },
              "statLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8
              },
              "featured": {
                "type": "boolean"
              }
            },
            "dependencies": {
              "statKey": [
                "statLabel"
              ]
            }
          }
        }
      }
    },
    "categoryLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "regulation",
        "beauty-personal-care"
      ],
      "properties": {
        "rules": {
          "type": "string",
          "minLength": 1
        },
        "regulation": {
          "type": "string",
          "minLength": 1
        },
        "beauty-personal-care": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample",
        "needsReview"
      ],
      "properties": {
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "needsReview": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewBanner": {
      "type": "string",
      "minLength": 4
    },
    "rankingBanner": {
      "type": "string",
      "minLength": 4
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "news",
        "regulation",
        "rankings",
        "platforms",
        "highlights"
      ],
      "properties": {
        "news": {
          "$ref": "#/definitions/section"
        },
        "regulation": {
          "$ref": "#/definitions/section"
        },
        "rankings": {
          "$ref": "#/definitions/section"
        },
        "platforms": {
          "$ref": "#/definitions/section"
        },
        "highlights": {
          "$ref": "#/definitions/section"
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "news",
        "rankings",
        "platforms"
      ],
      "properties": {
        "news": {
          "$ref": "#/definitions/page"
        },
        "rankings": {
          "$ref": "#/definitions/page"
        },
        "platforms": {
          "$ref": "#/definitions/page"
        }
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "news",
        "regulation",
        "rankings",
        "platforms",
        "highlights"
      ],
      "properties": {
        "news": {
          "type": "string",
          "minLength": 1
        },
        "regulation": {
          "type": "string",
          "minLength": 1
        },
        "rankings": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "string",
          "minLength": 1
        },
        "highlights": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notFound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skip",
        "all",
        "beautyOnly",
        "beautyPill",
        "allNews",
        "allRankings",
        "allPlatforms",
        "viewRanking",
        "viewSource",
        "officialSite",
        "sellerEntry",
        "entryFees",
        "entry",
        "fees",
        "note",
        "pricePending",
        "filterEmpty",
        "updatedPrefix",
        "backNews",
        "backRankings",
        "related",
        "market",
        "focus",
        "filterNews",
        "filterRegion",
        "openFull",
        "sourceLabel",
        "platformsLabel",
        "switchDate",
        "brandMark",
        "filterTag",
        "filterPlatform",
        "updatedAt",
        "checkedAt",
        "capturedAt",
        "publishedAt",
        "partial",
        "daysLeft",
        "daysPast",
        "today",
        "noRanking",
        "rankingTop",
        "resetFilters",
        "sourceName",
        "coverage",
        "keyDate",
        "boardPlan",
        "boardPlanNote",
        "boardLive",
        "boardPlanned",
        "zoomImage",
        "closeImage",
        "noImage",
        "originalTitle",
        "rating",
        "reviews",
        "sales"
      ],
      "properties": {
        "skip": {
          "type": "string"
        },
        "all": {
          "type": "string"
        },
        "beautyOnly": {
          "type": "string"
        },
        "beautyPill": {
          "type": "string"
        },
        "allNews": {
          "type": "string"
        },
        "allRankings": {
          "type": "string"
        },
        "allPlatforms": {
          "type": "string"
        },
        "viewRanking": {
          "type": "string"
        },
        "viewSource": {
          "type": "string"
        },
        "officialSite": {
          "type": "string"
        },
        "sellerEntry": {
          "type": "string"
        },
        "entryFees": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "fees": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "pricePending": {
          "type": "string"
        },
        "filterEmpty": {
          "type": "string"
        },
        "updatedPrefix": {
          "type": "string"
        },
        "backNews": {
          "type": "string"
        },
        "backRankings": {
          "type": "string"
        },
        "related": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "filterNews": {
          "type": "string"
        },
        "filterRegion": {
          "type": "string"
        },
        "openFull": {
          "type": "string"
        },
        "sourceLabel": {
          "type": "string"
        },
        "platformsLabel": {
          "type": "string"
        },
        "switchDate": {
          "type": "string"
        },
        "brandMark": {
          "type": "string"
        },
        "filterTag": {
          "type": "string"
        },
        "filterPlatform": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "checkedAt": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        },
        "partial": {
          "type": "string"
        },
        "daysLeft": {
          "type": "string"
        },
        "daysPast": {
          "type": "string"
        },
        "today": {
          "type": "string"
        },
        "noRanking": {
          "type": "string"
        },
        "rankingTop": {
          "type": "string"
        },
        "resetFilters": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "keyDate": {
          "type": "string"
        },
        "boardPlan": {
          "type": "string",
          "minLength": 1
        },
        "boardPlanNote": {
          "type": "string",
          "minLength": 1
        },
        "boardLive": {
          "type": "string",
          "minLength": 1
        },
        "boardPlanned": {
          "type": "string",
          "minLength": 1
        },
        "zoomImage": {
          "type": "string",
          "minLength": 1
        },
        "closeImage": {
          "type": "string",
          "minLength": 1
        },
        "noImage": {
          "type": "string",
          "minLength": 1
        },
        "originalTitle": {
          "type": "string",
          "minLength": 1
        },
        "rating": {
          "type": "string",
          "minLength": 1
        },
        "reviews": {
          "type": "string",
          "minLength": 1
        },
        "sales": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "newsTags": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8
      }
    },
    "rankingGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "tried",
          "reason",
          "source_url"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "tried": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          }
        }
      }
    },
    "rankingPlatforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "code",
          "market"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}$"
          },
          "market": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "platform": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "board_url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          }
        }
      }
    }
  },
  "definitions": {
    "internalHref": {
      "type": "string",
      "pattern": "^/([a-z0-9-]+(/[a-z0-9-]+)*)?(\\?[a-z]+=[a-z0-9-]+)?$"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "title",
        "note"
      ],
      "properties": {
        "index": {
          "type": "string",
          "pattern": "^\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "note"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
