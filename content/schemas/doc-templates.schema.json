{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocTemplates",
  "type": "object",
  "additionalProperties": false,
  "required": ["disclaimer", "badge", "templates"],
  "properties": {
    "disclaimer": { "type": "string", "minLength": 12, "maxLength": 160 },
    "badge": { "type": "string", "minLength": 2, "maxLength": 16 },
    "templates": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/definitions/template" }
    }
  },
  "definitions": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_zh", "summary", "group", "layout", "priority", "aliases", "specimen"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name_zh": { "type": "string", "minLength": 2, "maxLength": 24 },
        "summary": { "type": "string", "minLength": 8, "maxLength": 100 },
        "group": { "enum": ["委托与主体", "配方与标签", "检测与证明", "登记与平台"] },
        "layout": {
          "enum": ["letter", "table", "label", "lab", "certificate", "report", "dossier", "form", "platform", "marking", "receipt"]
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "preferTypes": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": ["local-rep", "registration", "safety", "testing", "label", "packaging", "marking", "halal", "platform", "tax-customs"]
          }
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 2, "maxLength": 40 }
        },
        "highlights": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "field"],
            "properties": {
              "alias": { "type": "string", "minLength": 2, "maxLength": 40 },
              "field": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          }
        },
        "specimen": { "$ref": "#/definitions/specimen" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "role": { "type": "string", "maxLength": 16 },
        "label": { "type": "string", "maxLength": 16 },
        "name": { "type": "string", "maxLength": 40 },
        "value": { "type": "string", "maxLength": 180 }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "kicker": { "type": "string", "maxLength": 24 },
        "title": { "type": "string", "minLength": 2, "maxLength": 24 },
        "titleEn": { "type": "string", "maxLength": 48 },
        "refLabel": { "type": "string", "maxLength": 12 },
        "ref": { "type": "string", "maxLength": 24 },
        "refId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "issuer": { "type": "string", "maxLength": 32 },
        "subtitle": { "type": "string", "maxLength": 48 },
        "coverId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "paragraphs": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 4, "maxLength": 160 }
        },
        "parties": { "type": "array", "maxItems": 4, "items": { "$ref": "#/definitions/field" } },
        "rows": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/field" } },
        "columns": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 12 } },
        "table": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "maxLength": 28 }
          }
        },
        "tableField": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "checks": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 24 } },
        "signs": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/field" } },
        "stamp": { "type": "string", "maxLength": 8 },
        "qrCaption": { "type": "string", "maxLength": 16 },
        "footer": { "type": "string", "maxLength": 80 },
        "callout": { "type": "string", "maxLength": 120 },
        "calloutId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "chips": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/field" } }
      }
    }
  }
}
