{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlatformCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "source_note", "platforms"],
  "properties": {
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source_note": { "type": "string", "minLength": 8 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}
