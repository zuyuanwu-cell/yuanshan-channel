{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "platform.schema.json",
  "title": "Platform",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "url",
    "seller_url",
    "region",
    "market",
    "mentions_beauty",
    "focus",
    "pitch"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://\\S+$" },
    "seller_url": { "type": "string", "pattern": "^https?://\\S+$" },
    "region": { "type": "string", "minLength": 1 },
    "market": { "type": "string", "minLength": 1 },
    "mentions_beauty": {
      "type": "boolean",
      "description": "仅当该平台介绍原文写到「美妆」或「个护」时为 true。"
    },
    "focus": { "type": "string", "minLength": 1 },
    "pitch": { "type": "string", "minLength": 1 },
    "entry": { "type": "string" },
    "fees": { "type": "string" },
    "note": { "type": "string" },
    "screenshot_needed": { "type": "boolean" }
  }
}
