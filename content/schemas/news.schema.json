{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NewsFrontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "date",
    "category",
    "platforms",
    "tags",
    "source_url",
    "source_name",
    "checked",
    "summary",
    "needs_review",
    "sample"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 80
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "category": {
      "enum": [
        "rules",
        "regulation"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "source_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "key_date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "label"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        }
      }
    },
    "highlight": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "needs_review": {
      "type": "boolean"
    },
    "sample": {
      "type": "boolean"
    },
    "countries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      }
    }
  }
}