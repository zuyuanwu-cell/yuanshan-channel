{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactoryPromo",
  "type": "object",
  "additionalProperties": false,
  "required": ["eyebrow", "title", "text", "points", "ctaLabel", "ctaHref"],
  "properties": {
    "eyebrow": { "type": "string", "minLength": 2, "maxLength": 12 },
    "title": { "type": "string", "minLength": 4, "maxLength": 28 },
    "text": { "type": "string", "minLength": 20, "maxLength": 180 },
    "points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 }
    },
    "ctaLabel": { "type": "string", "minLength": 2, "maxLength": 8 },
    "ctaHref": {
      "type": "string",
      "pattern": "^#contact$|^/[A-Za-z0-9/_-]*$|^https://\\S+$"
    }
  }
}
