{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComplianceCountry",
  "type": "object",
  "additionalProperties": false,
  "required": ["country", "name_zh", "flag", "region", "difficulty", "summary", "items", "steps", "last_verified", "hs_codes"],
  "properties": {
    "country": { "type": "string", "pattern": "^[a-z]{2}$" },
    "name_zh": { "type": "string", "minLength": 2, "maxLength": 12 },
    "flag": { "type": "string", "minLength": 1, "maxLength": 8 },
    "region": { "enum": ["北美", "欧洲", "东南亚", "东亚", "俄语区", "中东", "拉美"] },
    "difficulty": { "enum": [1, 2, 3] },
    "summary": { "type": "string", "minLength": 8, "maxLength": 80 },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "type"],
        "properties": { "title": { "type": "string" }, "type": { "$ref": "#/definitions/itemType" } }
      }
    },
    "hs_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": { "enum": ["pending", "ready"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name_zh"],
            "properties": {
              "code": { "type": "string" },
              "name_zh": { "type": "string" },
              "duty": { "type": "string" },
              "source_url": { "type": "string", "pattern": "^https?://\\S+$" }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_zh", "authority", "type", "mandatory", "cost", "time", "docs", "who", "official_url", "source_checked", "needs_review"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name_zh": { "type": "string", "minLength": 2, "maxLength": 40 },
          "authority": { "type": "string", "minLength": 2, "maxLength": 40 },
          "type": { "$ref": "#/definitions/itemType" },
          "mandatory": { "type": "boolean" },
          "cost": { "type": "string", "minLength": 2 },
          "time": { "type": "string", "minLength": 2 },
          "docs": { "type": "array", "items": { "type": "string" } },
          "who": { "type": "string" },
          "note": { "type": "string", "maxLength": 80 },
          "official_url": { "type": "string", "pattern": "^https?://\\S+$" },
          "source_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "needs_review": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "itemType": { "enum": ["local-rep", "registration", "safety", "testing", "label", "packaging", "marking", "halal", "platform", "tax-customs"] }
  }
}
